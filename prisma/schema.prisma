generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id             Int         @id @default(autoincrement())
  name           String      @unique
  departamentoId Int
  departamento   departament @relation(fields: [departamentoId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  entregas entrega[]
}

model departament {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     users[]
  registro  registro[]
}

model pacientes {
  id                Int        @id @default(autoincrement())
  name              String
  lastName          String
  idNumber          String     @unique
  fechaDeNacimiento String
  edad              Int
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  entregas          entrega[]
  registros         registro[]
}

model registro {
  id              Int         @id @default(autoincrement())
  paciente_id     Int
  departamento_id Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  departamento    departament @relation(fields: [departamento_id], references: [id])
  paciente        pacientes   @relation(fields: [paciente_id], references: [id])
  entregas        entrega[]
}

model entrega {
  id          Int      @id @default(autoincrement())
  emisor_id   Int // user_id del staff que envía (microservicio login)
  receptor_id Int // user_id del staff que recibe (microservicio login)
  registro_id Int // registro_id
  estado      estado   @default(pendiente)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  registro    registro @relation(fields: [registro_id], references: [id])

  pacientes   pacientes? @relation(fields: [pacientesId], references: [id])
  pacientesId Int?
  users       users?     @relation(fields: [usersId], references: [id])
  usersId     Int?
}

enum estado {
  pendiente
  recibido
  no_recibido
}
